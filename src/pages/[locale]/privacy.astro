---
import PrivacyView from '@/components/pages/views/PrivacyView.astro';
import { getSecondaryLocales } from '@/i18n';

// Locale-prefixed Privacy Policy (`/<locale>/privacy`).
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<PrivacyView locale={locale} />
