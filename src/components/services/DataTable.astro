---
/**
 * A comparison table (v2 `.ds-table`). Cells are text, or `{ text, href }`
 * for a link. On a phone each row stacks into a block with its column labels
 * shown above each value, so nothing has to scroll sideways.
 */
interface Cell {
  text: string;
  href?: string;
}

interface Props {
  headers: string[];
  rows: (string | Cell)[][];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;
const toCell = (cell: string | Cell): Cell => (typeof cell === 'string' ? { text: cell } : cell);
const isExternal = (href: string) => href.startsWith('http');
---

<div class="ds-table-wrap" data-reveal>
  <table class="ds-table">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        {headers.map((header) => <th scope="col">{header}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map(toCell).map((cell, i) => (
              <td data-label={i === 0 ? undefined : headers[i]}>
                {cell.href ? (
                  <a href={cell.href} {...(isExternal(cell.href) ? { target: '_blank', rel: 'noopener' } : {})}>
                    {cell.text}
                  </a>
                ) : (
                  cell.text
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
