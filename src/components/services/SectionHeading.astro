---
/**
 * The head that opens a section on inner pages (v2): the "(02) Label" marker
 * (numbered automatically in page order, see `.ds-badge-marker` in ds.css),
 * a display heading, and an optional lead set to the far side.
 * `icon` is accepted for existing callers and not drawn.
 */
import Badge from '@/components/ui/data-display/Badge/Badge.astro';

interface Props {
  icon?: string;
  badge: string;
  heading: string;
  lead?: string;
}

const { badge, heading, lead } = Astro.props;
---

<div class="ds-head" data-reveal>
  <div>
    <Badge variant="brand">{badge}</Badge>
    <h2 class="ds-display ds-display--2 ds-head__title">{heading}</h2>
  </div>
  {lead && <p class="ds-head__lead">{lead}</p>}
</div>
