---
/**
 * The website packages and their prices. Shared by the Services hub and the
 * Websites page, so a price only ever changes in `pages.services.packages`.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { tData, defaultLocale, localizedPath } from '@/i18n';
import { cn } from '@/lib/cn';
import { bookingLinkAttrs } from '@/lib/booking';

interface Props {
  /** Locale whose copy this section renders. Defaults to the site default. */
  locale?: string;
}

interface Package {
  name: string;
  for: string;
  price: string;
  /** Approximate conversions shown under the USD price. */
  priceLocal: string[];
  /** Shown before the price, e.g. "from". Empty for a fixed price. */
  pricePrefix: string;
  bonus: string;
  features: string[];
  cta: string;
}

const { locale = defaultLocale } = Astro.props;

const packages = tData<{ badge: string; heading: string; lead: string; recommended: string; items: Package[]; note: string }>(
  'pages.services.packages',
  locale
)!;
const contactUrl = localizedPath('/contact', locale);
/** The middle package is the one we recommend. */
const RECOMMENDED_PACKAGE = 1;
---
<section id="packages" class="py-[var(--space-section-md)] bg-background border-t border-border">
  <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
    <div class="flex flex-col items-center gap-4 text-center" data-reveal>
      <div class="flex flex-col items-center gap-6">
        <Badge variant="brand" pill>
          <Icon name="tag" size="sm" />
          {packages.badge}
        </Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
          {packages.heading}
        </h2>
      </div>
      <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
        {packages.lead}
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      {packages.items.map((pkg, i) => {
        const recommended = i === RECOMMENDED_PACKAGE;
        return (
          <Card
            variant="elevated"
            padding="lg"
            class={cn('flex flex-col h-full', recommended && 'ring-2 ring-brand-500')}
            data-reveal
            data-reveal-delay={i || undefined}
          >
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-display text-xl font-bold text-foreground">{pkg.name}</h3>
              {recommended && <Badge variant="brand" pill>{packages.recommended}</Badge>}
            </div>
            <p class="mt-2 text-sm text-foreground-muted leading-relaxed">{pkg.for}</p>
            <p class="mt-6 flex items-baseline gap-2">
              {pkg.pricePrefix && <span class="text-sm text-foreground-muted">{pkg.pricePrefix}</span>}
              <span class="font-display text-4xl font-bold text-foreground">{pkg.price}</span>
            </p>
            <p class="mt-2 flex flex-wrap gap-x-3 text-sm text-foreground-muted">
              {pkg.priceLocal.map((price) => <span class="whitespace-nowrap">{price}</span>)}
            </p>
            <p class="mt-3 text-sm font-semibold text-brand-700 dark:text-brand-400">{pkg.bonus}</p>
            <ul class="mt-6 mb-8 flex flex-1 flex-col gap-3 border-t border-border pt-6">
              {pkg.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 shrink-0 mt-0.5" />
                  <span class="text-sm text-foreground-muted leading-relaxed">{feature}</span>
                </li>
              ))}
            </ul>
            <Button size="lg" fullWidth variant={recommended ? 'primary' : 'outline'} {...bookingLinkAttrs(contactUrl)}>
              {pkg.cta}
            </Button>
          </Card>
        );
      })}
    </div>

    <p class="text-sm text-foreground-muted text-center max-w-3xl mx-auto text-balance" data-reveal>
      {packages.note}
    </p>
  </div>
</section>
