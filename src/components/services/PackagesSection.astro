---
/**
 * The three website packages and their prices (v2 cards; the recommended
 * Business package in blue). Shared by the Services hub and the Websites
 * page, so a price only ever changes in `pages.services.packages`.
 */
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { tData, defaultLocale, localizedPath } from '@/i18n';
import { bookingLinkAttrs } from '@/lib/booking';

interface Props {
  /** Locale whose copy this section renders. Defaults to the site default. */
  locale?: string;
}

interface Package {
  name: string;
  for: string;
  price: string;
  /** Approximate conversions shown under the USD price. */
  priceLocal: string[];
  /** Shown before the price, e.g. "from". Empty for a fixed price. */
  pricePrefix: string;
  bonus?: string;
  features: string[];
  cta: string;
}

const { locale = defaultLocale } = Astro.props;

const packages = tData<{ badge: string; heading: string; lead: string; recommended: string; items: Package[]; note: string }>(
  'pages.services.packages',
  locale
)!;
const contactUrl = localizedPath('/contact', locale);
/** The middle package is the one we recommend. */
const RECOMMENDED_PACKAGE = 1;
---

<section id="packages" class="ds-wrap ds-section--sm">
  <div class="ds-head">
    <div>
      <Badge variant="brand">{packages.badge}</Badge>
      <h2 class="ds-display ds-display--1 ds-head__title">{packages.heading}</h2>
    </div>
    <p class="ds-head__lead">{packages.lead}</p>
  </div>

  <div class="pkgs">
    {
      packages.items.map((pkg, i) => {
        const recommended = i === RECOMMENDED_PACKAGE;
        return (
          <article class:list={['ds-card', 'pkg', recommended && 'ds-card--blue']} data-reveal>
            <div class="pkg__top">
              <h3 class="ds-title ds-title--md">{pkg.name}</h3>
              {recommended && <span class="ds-pill">{packages.recommended}</span>}
            </div>
            <p class="pkg__for">{pkg.for}</p>
            <p class="pkg__price">
              {pkg.pricePrefix && <span class="pkg__prefix">{pkg.pricePrefix}</span>}
              <span class="pkg__amount">{pkg.price}</span>
            </p>
            <p class="pkg__local">
              {pkg.priceLocal.map((price) => (
                <span>{price}</span>
              ))}
            </p>
            {pkg.bonus && <p class="pkg__bonus">{pkg.bonus}</p>}
            <ul class="ds-list pkg__features">
              {pkg.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <a class:list={['ds-btn', 'ds-btn--block', recommended ? 'ds-btn--light' : '']} {...bookingLinkAttrs(contactUrl)}>
              {pkg.cta}
              <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span>
            </a>
          </article>
        );
      })
    }
  </div>

  <p class="pkgs__note">{packages.note}</p>
</section>

<style>
  .pkgs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 18px;
    align-items: stretch;
  }
  .pkg {
    display: flex;
    flex-direction: column;
  }
  .pkg__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .pkg__top h3 {
    margin: 0;
  }
  .pkg__for {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .pkg__price {
    margin: 28px 0 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .pkg__prefix {
    font-size: var(--text-small);
    font-weight: 600;
  }
  .pkg__amount {
    font: 850 clamp(44px, 4.4vw, 64px) / 1 var(--font-latin);
    font-stretch: 110%;
    letter-spacing: -0.035em;
  }
  .pkg__local {
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-size: var(--text-small);
    opacity: 0.85;
  }
  .pkg__bonus {
    margin: 12px 0 0;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .pkg__features {
    flex: 1;
    margin: 24px 0 28px;
  }
  .pkgs__note {
    margin: 24px 0 0;
    max-width: 760px;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--ink-3);
  }
</style>
