---
/**
 * The service pages' FAQ: the design-system accordion (ds/Faq). Kept as its
 * own component so the existing callers don't change.
 */
import Faq from '@/components/ds/Faq.astro';

interface Props {
  items: { question: string; answer: string }[];
  name: string;
}

const { items, name } = Astro.props;
---

<Faq items={items} name={name} />
