---
/**
 * Case-study hero (v2, V5): the marker, the client's name as a display
 * headline, the summary, the facts as pills and the live-site button, then
 * the screenshot in a browser frame on the blue dotted panel. Tag pills are
 * gone: two projects don't need tag pages (they redirect to /projects/).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import ProjectCarousel from '@/components/projects/ProjectCarousel.astro';
import type { GallerySlide } from '@/lib/gallery';
import { t, getLocaleFromPath } from '@/i18n';

interface Props {
  title: string;
  description: string;
  meta?: string[];
  url?: string;
  repo?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  gallery?: GallerySlide[];
  /** Accepted for existing callers; not shown. */
  tags?: string[];
}

const { title, description, meta = [], url, image, imageAlt, gallery = [] } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
---

<header class="ds-wrap pjh">
  <span class="ds-marker ds-badge-marker">{t('projects.heroBadge', locale)}</span>
  <h1 class="ds-display pjh__title">{title}</h1>
  <div class="pjh__row">
    <div class="pjh__text">
      <p class="pjh__desc">{description}</p>
      {
        meta.length > 0 && (
          <ul class="pjh__meta">
            {meta.map((item) => (
              <li class="ds-pill ds-pill--outline">{item}</li>
            ))}
          </ul>
        )
      }
    </div>
    {
      url && (
        <a class="ds-btn" href={url} target="_blank" rel="noopener noreferrer">
          <Icon name="external-link" size="sm" />
          {t('projects.viewLiveSite', locale)}
        </a>
      )
    }
  </div>

  {
    (gallery.length > 1 || image) && (
      <div class="ds-blue pjh__media">
        {gallery.length > 1 ? (
          <ProjectCarousel slides={gallery} label={`${title} screenshots`} />
        ) : (
          image && (
            <div class="ds-frame pjh__frame">
              <div class="ds-frame__bar" aria-hidden="true">
                <i />
                <i />
                <i />
              </div>
              <Image src={image} alt={imageAlt || title} widths={[640, 960, 1400, 1900]} sizes="(min-width: 1480px) 1200px, 90vw" loading="eager" />
            </div>
          )
        )}
      </div>
    )
  }
</header>

<style>
  .pjh {
    padding-block: clamp(28px, 4vw, 40px) clamp(32px, 4vw, 56px);
  }
  .pjh__title {
    margin-block-start: clamp(18px, 2.4vw, 28px);
    font-size: clamp(46px, 8.4vw, 148px);
  }
  .pjh__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 40px;
    margin-block-start: clamp(24px, 3vw, 40px);
  }
  .pjh__text {
    display: grid;
    gap: 18px;
    max-width: 720px;
  }
  .pjh__desc {
    margin: 0;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .pjh__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pjh__media {
    margin-block-start: clamp(32px, 4vw, 56px);
    border-radius: 32px;
    padding: clamp(16px, 4vw, 64px);
    background-image: radial-gradient(rgb(255 255 255 / 0.16) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .pjh__frame {
    max-width: 1200px;
    margin-inline: auto;
  }
</style>
