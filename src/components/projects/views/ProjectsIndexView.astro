---
/**
 * ProjectsIndexView: the projects page (/projects/, /ar/projects/), rebuilt
 * in V5. The two client projects with their figures (the home page's
 * "Selected work" section), then the call to action. No tag filters: two
 * projects don't need them (the tag pages redirect here).
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import Work from '@/components/home/Work.astro';
import CtaBand from '@/components/patterns/CtaBand.astro';
import { t, defaultLocale, localizedPath, getLocaleDirection } from '@/i18n';
import { bookingLinkAttrs } from '@/lib/booking';

interface Props {
  /** Locale whose projects this index renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const arrow = getLocaleDirection(locale) === 'rtl' ? '←' : '→';
const contactUrl = localizedPath('/contact', locale);
const breadcrumbs = [
  { label: t('common.home', locale), href: localizedPath('/', locale) },
  { label: t('nav.items.projects', locale) },
];
---

<PageLayout title={t('projects.metaTitle', locale)} description={t('projects.metaDescription', locale)} flush>
  <Hero>
    <Badge slot="badge" variant="brand">{t('projects.heroBadge', locale)}</Badge>
    <h1 slot="title">{t('projects.title', locale)}</h1>
    <p slot="description">{t('projects.heroDescription', locale)}</p>
    <Breadcrumbs slot="bottom" items={breadcrumbs} class="pj-crumbs" />
  </Hero>

  <div class="pj-work">
    <Work locale={locale} auto hideAll />
  </div>

  <section class="ds-section--sm">
    <CtaBand>
      <h2>{t('projects.ctaHeading', locale)}</h2>
      <p>{t('projects.ctaLead', locale)}</p>
      <div class="pj-cta">
        <a class="ds-btn ds-btn--light" {...bookingLinkAttrs(contactUrl)}>
          {t('projects.ctaPrimary', locale)}<span aria-hidden="true">{arrow}</span>
        </a>
        <a class="ds-btn ds-btn--ghost-light" href={localizedPath('/about', locale)}>{t('projects.ctaSecondary', locale)}</a>
      </div>
    </CtaBand>
  </section>
</PageLayout>

<style>
  :global(.pj-crumbs) {
    margin-block-start: clamp(28px, 3vw, 40px);
  }
  .pj-work :global(#work) {
    padding-block-start: var(--section-y-sm);
  }
  .pj-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
