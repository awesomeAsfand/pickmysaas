---
/**
 * Inner-page hero (v2): the "(01) Label" marker, a display headline, and the
 * lead text and actions on one row beneath it, left-aligned like the v2 home.
 *
 * Slots: badge (the marker label; a Badge with variant="brand" renders as
 * plain marker text), title (the page's <h1>), description, actions, aside,
 * bottom. The older visual props (layout, size, showHeroHalo …) are accepted
 * so existing pages need no change, and ignored: there is one hero style.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  layout?: 'centered' | 'split';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showGrid?: boolean;
  showGlow?: boolean;
  showBlob?: boolean;
  showHeroHalo?: boolean;
  blobPosition?: 'left' | 'right' | 'center';
  bottomFade?: boolean;
  showScrollIndicator?: boolean;
  fullHeight?: boolean;
}

const {
  layout: _layout,
  size: _size,
  showGrid: _showGrid,
  showGlow: _showGlow,
  showBlob: _showBlob,
  showHeroHalo: _showHeroHalo,
  blobPosition: _blobPosition,
  bottomFade: _bottomFade,
  showScrollIndicator: _showScrollIndicator,
  fullHeight: _fullHeight,
  class: className,
  ...attrs
} = Astro.props;
---

<section class:list={['ds-wrap', 'phero', className]} {...attrs}>
  {
    Astro.slots.has('badge') && (
      <div class="phero__marker">
        <slot name="badge" />
      </div>
    )
  }
  <div class="phero__title">
    <slot name="title" />
  </div>
  {
    (Astro.slots.has('description') || Astro.slots.has('actions')) && (
      <div class="phero__row">
        <div class="phero__desc">
          <slot name="description" />
        </div>
        {Astro.slots.has('actions') && (
          <div class="phero__actions">
            <slot name="actions" />
          </div>
        )}
      </div>
    )
  }
  <slot name="aside" />
  <slot name="bottom" />
  <slot />
</section>

<style>
  .phero {
    padding-block: clamp(28px, 4vw, 40px) clamp(8px, 1.5vw, 24px);
  }
  .phero__marker {
    margin-block-end: clamp(18px, 2.4vw, 28px);
  }
  .phero__title :global(h1) {
    margin: 0;
    font-family: var(--fd);
    font-weight: 850;
    font-stretch: var(--fs);
    text-transform: var(--tt);
    font-size: clamp(40px, 6.4vw, 108px) !important;
    line-height: var(--hlh) !important;
    letter-spacing: var(--hls);
    text-wrap: balance;
    max-width: 1300px;
  }
  .phero__title :global(h1 .text-brand-500) {
    color: var(--blue);
  }
  .phero__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 40px;
    margin-block-start: clamp(24px, 3vw, 40px);
  }
  .phero__desc {
    max-width: 640px;
  }
  .phero__desc :global(p) {
    margin: 0;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--ink-2);
  }
  .phero__desc :global(p + p) {
    margin-block-start: 12px;
  }
  .phero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
