---
/**
 * CtaBand: the block that closes a page (v2): a dark ink panel with a
 * display heading, a line of text and the actions, left-aligned like v2's
 * "Let's talk." The floating WhatsApp button hides over it (data-hide-fab),
 * since these panels carry their own WhatsApp button.
 *
 * Slot: the heading, text and buttons. `maxWidth` and `grid` are accepted for
 * existing callers and ignored.
 */
interface Props {
  maxWidth?: '6xl' | '7xl';
  grid?: boolean;
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['ds-wrap', className]}>
  <div class="cta-band invert-section" data-hide-fab data-reveal>
    <slot />
  </div>
</div>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    border-radius: 32px;
    padding: clamp(40px, 6vw, 96px) clamp(24px, 5vw, 80px);
    background: var(--ink);
    color: var(--on-ink);
    text-align: start;
  }
  .cta-band::after {
    content: '';
    position: absolute;
    inset-inline-end: -6%;
    bottom: -40%;
    width: clamp(200px, 30vw, 420px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--blue);
    opacity: 0.9;
    pointer-events: none;
  }
  .cta-band > :global(*) {
    position: relative;
    z-index: 1;
  }
  .cta-band :global(h2) {
    margin: 0 0 18px !important;
    font-family: var(--fd);
    font-weight: 850;
    font-stretch: var(--fs);
    text-transform: var(--tt);
    font-size: clamp(36px, 5.4vw, 88px) !important;
    line-height: var(--hlh) !important;
    letter-spacing: var(--hls);
    color: var(--on-ink) !important;
    max-width: 900px;
    text-align: start;
  }
  .cta-band :global(p) {
    margin: 0 0 32px !important;
    max-width: 560px;
    font-size: var(--text-lead) !important;
    line-height: 1.55;
    color: var(--on-ink-2) !important;
    text-align: start;
  }
  .cta-band :global(.justify-center),
  .cta-band :global(.items-center) {
    justify-content: flex-start;
    align-items: flex-start;
  }
  .cta-band :global(.mx-auto) {
    margin-inline: 0;
  }
  .cta-band :global(.text-center) {
    text-align: start;
  }
</style>
