---
/**
 * Site header (v2): a floating pill, fixed near the top of every page.
 *
 * Wide screens (≥1024px): wordmark · nav links · EN/عربي · "Book a call".
 * Phones and tablets: wordmark · EN/عربي · Menu button, which opens a panel
 * with every nav link, the booking button and WhatsApp (fix 2).
 *
 * Every link is a real <a>, so the header works without JavaScript; the only
 * script opens and closes the phone panel (Escape, outside click and link
 * clicks close it; focus stays inside while it is open). Without JavaScript
 * the panel cannot open, but every link it holds is also in the footer.
 */
import { getNavItems, getLogoHref } from '@/config/nav.config';
import LangSwitch from '@/components/layout/LangSwitch.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { getLocaleFromPath, getLocaleDirection, localizedPath, stripLocaleFromPath, t } from '@/i18n';
import { getBlogBaseUrl, BLOG_VISIBLE } from '@/lib/blog';
import { bookingLinkAttrs, whatsAppUrl } from '@/lib/booking';

interface Props {
  /** Per-locale URLs for the language switch (see LangSwitch). */
  languageAlternates?: Record<string, string>;
  /** The page has no translation; the switch points to a related page. */
  notTwin?: boolean;
}

const { languageAlternates, notTwin = false } = Astro.props;

const path = Astro.url.pathname;
const locale = getLocaleFromPath(path);
const rtl = getLocaleDirection(locale) === 'rtl';
const arrow = rtl ? '←' : '→';

const navItems = getNavItems(locale).filter(
  (item) => stripLocaleFromPath(item.href) !== '/' && (BLOG_VISIBLE || item.href !== getBlogBaseUrl(locale))
);
const isActive = (href: string) => path === href || path.startsWith(href.endsWith('/') ? href : `${href}/`);

const booking = bookingLinkAttrs(localizedPath('/contact', locale));
const whatsApp = whatsAppUrl(t('common.whatsappMessage', locale));
---

<header class="hdr" data-header>
  <div class="hdr__bar">
    <a href={getLogoHref(locale)} class="hdr__logo" dir="ltr" aria-label={t('ds.header.home', locale)}>
      PICKMYSAAS<span class="ds-dot" aria-hidden="true"></span>
    </a>

    <nav class="hdr__nav" aria-label={t('nav.mainNav', locale)}>
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <LangSwitch alternates={languageAlternates} notTwin={notTwin} />

    <a class="hdr__cta ds-btn ds-btn--sm" {...booking}>
      {t('ds.header.book', locale)}<span aria-hidden="true">{arrow}</span>
    </a>

    <button
      type="button"
      class="hdr__menu"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={t('nav.openMenu', locale)}
      data-label-open={t('nav.openMenu', locale)}
      data-label-close={t('nav.closeMenu', locale)}
    >
      <span class="hdr__menu-text">{t('ds.header.menu', locale)}</span>
      <span class="hdr__menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="hdr__backdrop" data-menu-backdrop hidden></div>
  <div id="site-menu" class="hdr__panel" hidden>
    <nav aria-label={t('nav.mobileNav', locale)}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span>{item.label}</span>
                <span aria-hidden="true">{arrow}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="hdr__panel-actions">
      <a class="ds-btn ds-btn--blue ds-btn--block" {...booking}>
        {t('ds.header.book', locale)}<span aria-hidden="true">{arrow}</span>
      </a>
      {
        whatsApp && (
          <a class="ds-btn ds-btn--whatsapp ds-btn--block" href={whatsApp} target="_blank" rel="noopener noreferrer" data-whatsapp>
            <span class="hdr__wa">
              <Icon name="whatsapp" size="sm" />
              {t('common.whatsappChat', locale)}
            </span>
            <span aria-hidden="true">{arrow}</span>
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    top: 14px;
    inset-inline: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 14px;
    pointer-events: none;
  }
  .hdr__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 8px;
    padding-inline-start: 20px;
    border-radius: 999px;
    background: rgb(248 246 241 / 0.82);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid rgb(18 18 18 / 0.1);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.18);
    max-width: 100%;
  }
  .hdr__logo {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    font: 850 14px/1 var(--font-latin);
    font-stretch: 125%;
    color: var(--ink);
    white-space: nowrap;
  }
  .hdr__nav {
    display: flex;
    gap: 20px;
    font-size: 14px;
    font-weight: 500;
  }
  .hdr__nav a {
    padding-block: 8px;
    color: var(--ink);
    transition: color 0.2s;
  }
  .hdr__nav a:hover,
  .hdr__nav a[aria-current='page'] {
    color: var(--blue);
  }
  .hdr__cta {
    gap: 8px;
  }

  .hdr__menu {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--white);
    font-size: 14px;
    font-weight: 600;
  }
  .hdr__menu-icon {
    display: grid;
    gap: 4px;
    width: 16px;
  }
  .hdr__menu-icon i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s;
  }
  .hdr__menu[aria-expanded='true'] .hdr__menu-icon i:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }
  .hdr__menu[aria-expanded='true'] .hdr__menu-icon i:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  .hdr__backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: auto;
    background: rgb(18 18 18 / 0.3);
  }
  .hdr__panel {
    pointer-events: auto;
    position: fixed;
    top: 78px;
    inset-inline: 14px;
    max-height: calc(100dvh - 92px);
    overflow-y: auto;
    padding: 12px 22px 22px;
    border-radius: 28px;
    background: var(--card-paper);
    border: 1.5px solid var(--ink);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5);
  }
  .hdr__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hdr__panel li + li {
    border-block-start: 1px solid var(--line);
  }
  .hdr__panel nav a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 16px;
    font-family: var(--fd);
    font-weight: 850;
    font-stretch: var(--fs);
    text-transform: var(--tt);
    letter-spacing: var(--ls);
    font-size: clamp(28px, 8vw, 40px);
    line-height: 1.05;
    color: var(--ink);
  }
  .hdr__panel nav a[aria-current='page'] {
    color: var(--blue);
  }
  .hdr__panel-actions {
    display: grid;
    gap: 10px;
    margin-block-start: 18px;
  }
  .hdr__wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hdr__panel:not([hidden]) {
      animation: pm-fade 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  /* Phones and tablets: the nav and CTA move into the panel. */
  @media (max-width: 1023.98px) {
    .hdr__bar {
      gap: 10px;
      padding-inline-start: 16px;
      width: 100%;
      justify-content: space-between;
    }
    .hdr__nav,
    .hdr__cta {
      display: none;
    }
    .hdr__menu {
      display: inline-flex;
    }
    .hdr__bar :global(.lang-switch) {
      margin-inline-start: auto;
    }
  }
  @media (max-width: 359.98px) {
    .hdr__menu-text {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .hdr__panel,
    .hdr__backdrop {
      display: none !important;
    }
  }
</style>

<script>
  import { trapFocus } from '@/lib/focus-trap';

  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const button = header?.querySelector<HTMLButtonElement>('.hdr__menu');
    const panel = header?.querySelector<HTMLElement>('#site-menu');
    const backdrop = header?.querySelector<HTMLElement>('[data-menu-backdrop]');
    if (!header || !button || !panel || !backdrop || button.dataset.ready) return;
    button.dataset.ready = 'true';

    let release: (() => void) | null = null;

    const setOpen = (open: boolean, returnFocus = true) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
      panel.hidden = !open;
      backdrop.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) {
        release = trapFocus(header);
        panel.querySelector<HTMLElement>('a')?.focus();
      } else {
        release?.();
        release = null;
        if (returnFocus) button.focus();
      }
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    backdrop.addEventListener('click', () => setOpen(false));
    panel.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false, false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) setOpen(false);
    });
    // Rotating a tablet to landscape shows the full nav: close the panel.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (query) => {
      if (query.matches && !panel.hidden) setOpen(false, false);
    });
  }

  initHeader();
</script>
