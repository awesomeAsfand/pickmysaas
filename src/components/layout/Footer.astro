---
/**
 * Site footer (v2): dark, with link columns and the giant PICKMYSAAS. wordmark.
 *
 * Columns: who we are · services · studio pages · guides (each language lists
 * only the guides written in it) · contact. Under the about text, a "Find us
 * on" line links the public profiles in `siteConfig.socialLinks` that have a
 * name below (review directories first, since they carry client reviews).
 *
 * The floating WhatsApp button hides while this footer is on screen.
 */
import siteConfig from '@/config/site.config';
import { getLocaleFromPath, getLocaleDirection, localizedPath, t } from '@/i18n';
import { bookingLinkAttrs, whatsAppUrl } from '@/lib/booking';

const locale = getLocaleFromPath(Astro.url.pathname);
const arrow = getLocaleDirection(locale) === 'rtl' ? '←' : '→';
const year = new Date().getFullYear();
const lp = (path: string) => localizedPath(path, locale);
const whatsApp = whatsAppUrl(t('common.whatsappMessage', locale));

// Profile names for the "Find us on" line. A URL with no match here still
// goes into the structured data's sameAs, just not into the footer.
const PROFILE_NAMES: Record<string, string> = {
  'clutch.co': 'Clutch',
  'sortlist.com': 'Sortlist',
  'techbehemoths.com': 'TechBehemoths',
  'entasher.com': 'Entasher',
  'goodfirms.co': 'GoodFirms',
  'designrush.com': 'DesignRush',
  'linkedin.com': 'LinkedIn',
};
const profiles = siteConfig.socialLinks.flatMap((href) => {
  const host = new URL(href).hostname.replace(/^www\./, '');
  const name = PROFILE_NAMES[host];
  return name ? [{ href, name }] : [];
});

const columns = [
  {
    title: t('ds.footer.servicesTitle', locale),
    links: [
      { label: t('ds.footer.websites', locale), href: lp('/services/websites') },
      { label: t('ds.footer.ecommerce', locale), href: lp('/services/ecommerce') },
      { label: t('ds.footer.allServices', locale), href: lp('/services') },
    ],
  },
  {
    title: t('ds.footer.studioTitle', locale),
    links: [
      { label: t('nav.items.projects', locale), href: lp('/projects') },
      { label: t('nav.items.about', locale), href: lp('/about') },
      { label: t('nav.items.contact', locale), href: lp('/contact') },
      { label: t('consent.ui.privacyPolicyLabel', locale), href: lp('/privacy') },
    ],
  },
  {
    title: t('ds.footer.guidesTitle', locale),
    links:
      locale === 'ar'
        ? [
            { label: t('ds.footer.costGuide', locale), href: '/ar/guides/website-cost/' },
            { label: t('ds.footer.comparison', locale), href: '/ar/guides/salla-vs-shopify-vs-custom-store/' },
          ]
        : [
            { label: t('ds.footer.costGuide', locale), href: '/guides/website-cost-uae/' },
            { label: t('ds.footer.comparison', locale), href: '/guides/salla-vs-shopify-vs-custom-store/' },
          ],
  },
];
---

<footer class="ftr ds-dark">
  <div class="ds-wrap ftr__top">
    <div class="ftr__about">
      <p class="ftr__tagline">{t('ds.footer.tagline', locale)}</p>
      <p>{t('ds.footer.about', locale)}</p>
      <p>{t('ds.footer.remote', locale)}</p>
      {
        profiles.length > 0 && (
          <p class="ftr__profiles">
            {t('ds.footer.profiles', locale)}{' '}
            {profiles.map((profile, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={profile.href} target="_blank" rel="noopener" dir="ltr">{profile.name}</a>
              </>
            ))}
          </p>
        )
      }
    </div>

    {
      columns.map((column) => (
        <nav class="ftr__col" aria-label={column.title}>
          <p class="ftr__title">{column.title}</p>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="ftr__col">
      <p class="ftr__title">{t('ds.footer.contactTitle', locale)}</p>
      <ul>
        <li>
          <a {...bookingLinkAttrs(lp('/contact'))}>
            {t('ds.footer.book', locale)} <span aria-hidden="true">{arrow}</span>
          </a>
        </li>
        {
          whatsApp && (
            <li>
              <a href={whatsApp} target="_blank" rel="noopener noreferrer" data-whatsapp>
                {t('ds.footer.whatsapp', locale)}
              </a>
            </li>
          )
        }
        <li>
          <a href={`mailto:${siteConfig.email}`} dir="ltr">{siteConfig.email}</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="ds-wrap ftr__bottom">
    <span>
      {t('footer.copyright', locale, { year, siteName: siteConfig.name })} · {t('ds.footer.tagline', locale)}
    </span>
  </div>

  <div class="ftr__mark" dir="ltr" aria-hidden="true">
    {'PICKMYSAAS'.split('').map((letter) => <span>{letter}</span>)}<span class="ftr__dot">.</span>
  </div>
</footer>

<style>
  .ftr {
    overflow: hidden;
    font-size: var(--text-small);
  }
  .ftr__top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
    gap: 40px 32px;
    padding-block-start: clamp(56px, 7vw, 96px);
  }
  .ftr__about {
    display: grid;
    gap: 12px;
    align-content: start;
    max-width: 380px;
    color: var(--on-ink-muted);
    line-height: 1.6;
  }
  .ftr__about p {
    margin: 0;
  }
  .ftr__tagline {
    font-family: var(--fd);
    font-weight: 800;
    font-stretch: var(--fs);
    text-transform: var(--tt);
    letter-spacing: var(--ls);
    line-height: var(--lh);
    font-size: 22px;
    color: var(--on-ink);
  }
  .ftr__title {
    margin: 0 0 14px;
    font-family: var(--fb);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--on-ink-muted);
  }
  .ftr__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .ftr__col a,
  .ftr__profiles a {
    color: var(--on-ink);
    transition: color 0.2s;
  }
  .ftr__profiles a {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--on-ink-muted);
  }
  .ftr__col a:hover,
  .ftr__profiles a:hover {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 1.5px;
  }
  .ftr :focus-visible {
    outline-color: var(--on-ink);
  }
  .ftr__bottom {
    margin-block-start: clamp(48px, 6vw, 80px);
    padding-block-start: 20px;
    border-block-start: 1px solid var(--line-on-ink);
    color: var(--on-ink-muted);
  }
  .ftr__mark {
    display: flex;
    justify-content: center;
    font: 900 10.6vw/0.8 var(--font-latin);
    font-stretch: 125%;
    letter-spacing: -0.045em;
    white-space: nowrap;
    padding-block-start: 5vw;
    margin-block-end: -0.06em;
    color: var(--on-ink);
    user-select: none;
  }
  .ftr__mark span {
    display: inline-block;
    transition:
      transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1),
      color 0.25s;
  }
  .ftr__mark span:hover {
    transform: translateY(-0.12em);
    color: var(--blue);
  }
  .ftr__mark .ftr__dot {
    color: var(--blue);
  }

  @media (max-width: 1023.98px) {
    .ftr__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ftr__about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 479.98px) {
    .ftr__top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
