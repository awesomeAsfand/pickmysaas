---
/**
 * The home page (V2), in the v2 design, as server-rendered HTML in the page's
 * language. Section order, as v2 plus the new sections:
 *
 *   (01) hero + live demo store + facts strip · marquee · (02) bilingual ·
 *   (03) services · (04) process · (05) pricing teaser (new) · (06) about ·
 *   (07) FAQ (new) · (08) contact. Selected work lives on /projects/ only
 *   (owner, 19 Nov 2026).
 *
 * Copy lives in src/i18n/<locale>.json under `home`. Structured data:
 * ProfessionalService (BaseLayout) and FAQPage matching the visible FAQ.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Bilingual from '@/components/home/Bilingual.astro';
import Services from '@/components/home/Services.astro';
import Process from '@/components/home/Process.astro';
import PricingTeaser from '@/components/home/PricingTeaser.astro';
import About from '@/components/home/About.astro';
import Contact from '@/components/home/Contact.astro';
import SectionHead from '@/components/ds/SectionHead.astro';
import Faq from '@/components/ds/Faq.astro';
import { createFAQSchema } from '@/lib/schema';
import { t, tData, localizedPath, getLocales } from '@/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const links = {
  pricing: localizedPath('/pricing', locale),
  comparison: locale === 'ar' ? '/ar/guides/salla-vs-shopify-vs-custom-store/' : '/guides/salla-vs-shopify-vs-custom-store/',
};
const fill = (html: string) => html.replace(/\{(\w+)\}/g, (m, key: keyof typeof links) => links[key] ?? m);
const faq = tData<{ question: string; answer: string }[]>('home.faq.items', locale)!.map((item) => ({
  question: item.question,
  answer: fill(item.answer),
}));
const plain = (html: string) => html.replace(/<[^>]+>/g, '');

// Every configured locale has a home page: hreflang and the language switch.
const homeAlternates = getLocales().map((loc) => ({ locale: loc, url: localizedPath('/', loc) }));
---

<PageLayout
  title={t('home.meta.title', locale)}
  description={t('home.meta.description', locale)}
  localeAlternates={homeAlternates}
  includeProfessionalServiceSchema
  extraSchemas={[createFAQSchema(faq.map((f) => ({ question: f.question, answer: plain(f.answer) })))]}
  flush
>
  <Hero locale={locale} />
  <Bilingual locale={locale} />
  <Services locale={locale} />
  <Process locale={locale} />
  <PricingTeaser locale={locale} />
  <About locale={locale} />

  <section id="faq" class="ds-wrap ds-section">
    <SectionHead n="07" label={t('home.faq.label', locale)} title={t('home.faq.title', locale)} />
    <Faq items={faq} name="home-faq" headingLevel="h3" />
  </section>

  <Contact locale={locale} />
</PageLayout>
