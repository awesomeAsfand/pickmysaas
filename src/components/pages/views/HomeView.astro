---
/**
 * HomeView — the landing page body, built from the "Home Premium" design
 * (design/PickMySaaS website overview/Home Premium.dc.html).
 *
 * Shared by the default-locale route (`/`) and the locale-prefixed route
 * (`/<locale>`). All copy is read from `pages.home.*` via `t()` / `tData()`.
 * The page has a dark and a light palette, following the site's colour mode; its styles live in
 * `src/styles/home-premium.css`, scoped under `.hp`.
 *
 * Images come from `src/assets/home/` by slot id (see `@/lib/home-media` and
 * the README in that folder). Empty slots and copy written as "[...]" show as
 * placeholders in `astro dev` and are left out of production builds.
 */
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@/styles/home-premium.css';
import LandingLayout from '@/layouts/LandingLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import HomeSlot from '@/components/landing/HomeSlot.astro';
import { getCollection } from 'astro:content';
import { getPostUrl, getPublishedPosts, BLOG_VISIBLE } from '@/lib/blog';
import { getVisibleProjects, getProjectUrl } from '@/lib/projects';
import { t, tData, defaultLocale, localizedPath, getLocales } from '@/i18n';
import { bookingLinkAttrs, whatsAppUrl } from '@/lib/booking';
import { homeImage, isPlaceholder, slotAspect, showCopy, showSlot, SHOW_PLACEHOLDERS } from '@/lib/home-media';

interface Props {
  /** Locale whose copy and content this page renders. Defaults to the site default. */
  locale?: string;
}

interface Result {
  value: string;
  label: string;
}
interface WorkCopy {
  slug: string;
  label: string;
  location: string;
  headline: string;
  results: Result[];
  thumbs: string[];
}
interface ConceptCopy {
  label: string;
  location: string;
  headline: string;
  description: string;
  results: Result[];
  stack: string[];
  thumbs: string[];
}
interface TitledText {
  title: string;
  description: string;
}

const { locale = defaultLocale } = Astro.props;
const fill = (template: string, values: Record<string, string>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? '');
/** Two-digit section and step numbers: 01, 02 … */
const pad = (n: number) => String(n).padStart(2, '0');

const hero = tData<{
  badgeTag: string;
  badge: string;
  titleMain: string;
  titleAccent: string;
  description: string;
  descriptionMobile: string;
  primaryCta: string;
  secondaryCta: string;
  desktopAlt: string;
  phoneEnAlt: string;
  phoneArAlt: string;
  mockupUrl: string;
}>('pages.home.hero', locale)!;
const work = tData<{
  label: string;
  headingMain: string;
  headingAccent: string;
  caseStudy: string;
  viewAll: string;
  concept: string;
  mobileAlt: string;
  thumbAlt: string;
  items: WorkCopy[];
  conceptItem: ConceptCopy;
}>('pages.home.work', locale)!;
const services = tData<{
  label: string;
  headingMain: string;
  headingAccent: string;
  lead: string;
  learnMore: string;
  imageAlt: string;
  cards: { key: string; title: string; price: string; description: string }[];
}>('pages.home.services', locale)!;
const included = tData<{
  label: string;
  headingMain: string;
  headingAccent: string;
  lead: string;
  items: (TitledText & { icon: string })[];
  note: string;
  cta: string;
}>('pages.home.included', locale)!;
const processSection = tData<{
  label: string;
  headingMain: string;
  headingAccent: string;
  timeline: {
    scaleLabel: string;
    rows: { label: string; sub: string; value: string }[];
    demoLegend: string;
    rangeLegend: string;
    launch: string;
    footnote: string;
  };
  steps: TitledText[];
}>('pages.home.process', locale)!;
/** Weeks on the process timeline's scale, and a week's position along it. */
const TIMELINE_WEEKS = 8;
const pct = (weeks: number) => `${(weeks / TIMELINE_WEEKS) * 100}%`;
const stackCopy = tData<{ label: string }>('pages.home.stack', locale)!;
const blogSection = tData<{ badge: string; heading: string; viewAll: string }>('pages.home.blog', locale)!;
const cta = tData<{
  headingMain: string;
  headingAccent: string;
  description: string;
  contactName: string;
  contactNote: string;
  primary: string;
  whatsapp: string;
  /** Shown in the round avatar until cta-founder has a photo. */
  initials: string;
}>('pages.home.cta', locale)!;

// ── Projects ───────────────────────────────────────────────────────────────
// The work cards pair each project's homepage copy (pages.home.work.items, by
// slug) with the project itself, falling back to the default locale's project
// when this locale hasn't translated it.
let projectItems = await getVisibleProjects(locale);
const defaultProjects = locale === defaultLocale ? projectItems : await getVisibleProjects(defaultLocale);
if (projectItems.length === 0) projectItems = defaultProjects;
const findProject = (slug: string) =>
  projectItems.find((p) => p.id.endsWith(slug)) ?? defaultProjects.find((p) => p.id.endsWith(slug));

const workCards = work.items.flatMap((copy) => {
  const project = findProject(copy.slug);
  if (!project) return [];
  return [
    {
      key: copy.slug,
      copy,
      title: project.data.title,
      description: project.data.description,
      tags: project.data.tags,
      image: project.data.image,
      imageAlt: project.data.imageAlt ?? project.data.title,
      href: getProjectUrl(project.id, project.data.locale),
    },
  ];
});
// The design's e-commerce "concept" card. Its copy is still placeholder text,
// so it only appears in dev until it's filled in.
const concept = work.conceptItem;
const conceptReady = [concept.location, concept.headline, concept.description, ...concept.stack]
  .concat(concept.results.flatMap((r) => [r.value, r.label]))
  .every((s) => !isPlaceholder(s));
const showConcept = conceptReady || SHOW_PLACEHOLDERS;

// Every card on the list, in order: the e-commerce concept sits second.
// The concept card has no case study, so no link, and carries a "Concept" badge.
const workEntries = [
  ...workCards.map((c) => ({
    key: c.key,
    label: c.copy.label,
    location: c.copy.location,
    headline: c.copy.headline,
    description: c.description,
    results: c.copy.results,
    tags: c.tags,
    thumbs: c.copy.thumbs,
    title: c.title,
    image: c.image as typeof c.image | undefined,
    imageAlt: c.imageAlt,
    href: c.href as string | undefined,
    isConcept: false,
  })),
];
if (showConcept) {
  workEntries.splice(Math.min(1, workEntries.length), 0, {
    key: 'shop',
    label: concept.label,
    location: concept.location,
    headline: concept.headline,
    description: concept.description,
    results: concept.results,
    tags: concept.stack,
    thumbs: concept.thumbs,
    title: concept.label,
    image: undefined,
    imageAlt: concept.headline,
    href: undefined,
    isConcept: true,
  });
}

const heroProject = workCards[0];
// The address shown in the hero's browser bar. With your own hero image it's
// `pages.home.hero.mockupUrl` (empty hides it); with the fallback screenshot
// it's that project's domain.
const heroUrlLabel = (() => {
  if (homeImage('hero-desktop', locale)) return hero.mockupUrl.trim();
  const project = heroProject && findProject(heroProject.key);
  const url = project?.data.url;
  return url ? new URL(url).hostname.replace(/^www\./, '') : 'pickmysaas.com';
})();

// ── Services ───────────────────────────────────────────────────────────────
const serviceUrls: Record<string, string> = {
  web: localizedPath('/services/websites', locale),
  // Online stores have their own page.
  shop: localizedPath('/services/ecommerce', locale),
  saas: localizedPath('/services/saas', locale),
  // The MVP page is English-only for now; other locales go to the services index.
  mvp: locale === defaultLocale ? localizedPath('/services/mvp', locale) : localizedPath('/services', locale),
};
const serviceCards = services.cards.filter((c) => [c.title, c.price, c.description].every(showCopy));

// ── Stack ──────────────────────────────────────────────────────────────────
const stackItems = (await getCollection('stack'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => ({ name: e.data.name, icon: e.data.icon, url: e.data.url }));

// ── Blog (hidden until the blog launches) ──────────────────────────────────
let postItems = await getPublishedPosts(locale);
if (postItems.length === 0 && locale !== defaultLocale) postItems = await getPublishedPosts(defaultLocale);
const posts = [...postItems]
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 3);

// Section numbers follow what's actually on the page, so a hidden section
// (like the blog before it launches) doesn't leave a gap in the sequence.
let sectionNo = 0;
const nextNo = () => `(${pad(++sectionNo)})`;

const contactUrl = localizedPath('/contact', locale);
const websitesUrl = localizedPath('/services/websites', locale);
const projectsUrl = localizedPath('/projects', locale);
const blogUrl = localizedPath('/blog', locale);
const whatsAppHref = whatsAppUrl(t('common.whatsappMessage', locale));

// Every configured locale has a home page, so they are offered as alternates:
// hreflang tags and the header language switcher.
const homeAlternates = getLocales().map((loc) => ({ locale: loc, url: localizedPath('/', loc) }));
---

<LandingLayout
  title={t('pages.home.meta.title', locale)}
  description={t('pages.home.meta.description', locale)}
  includeProfessionalServiceSchema={true}
  localeAlternates={homeAlternates}
>
  <div class="hp">
    <!-- Hero.
         data-header-flip-anchor: the floating header keeps its over-the-hero
         look until this section is nearly out from under it (Header.astro).
         data-bar-color: Safari on iOS tints its floating toolbar from the
         BODY's background, which is white in light mode. The theme script
         paints the body this colour while the hero covers the foot of the
         screen. It must equal --bar-color on .hp-hero in home-premium.css
         (checked by bar-color.test.ts). In light mode the hero is white like
         the body, so data-bar-color-light is empty and nothing is painted. -->
    <section class="hp-hero" data-header-flip-anchor data-bar-color="#07090d" data-bar-color-light="">
      <div class="hp-hero-grid" aria-hidden="true"></div>
      <div class="hp-container hp-hero-inner">
        <p class="hp-pill">
          <span class="hp-pill-tag">{hero.badgeTag}</span>
          {hero.badge}
        </p>

        <h1 class="hp-h1">
          {hero.titleMain} <span class="hp-accent">{hero.titleAccent}</span>
        </h1>

        <p class="hp-hero-lead">
          <span class="sm:hidden">{hero.descriptionMobile}</span>
          <span class="hidden sm:inline">{hero.description}</span>
        </p>

        <div class="hp-actions">
          <a class="hp-btn hp-btn-primary" {...bookingLinkAttrs(contactUrl)}>
            {hero.primaryCta}
            <Icon name="arrow-right" size="sm" class="rtl:-scale-x-100" />
          </a>
          <a class="hp-btn hp-btn-ghost" href="#work">
            {hero.secondaryCta}
            <Icon name="arrow-down" size="sm" />
          </a>
        </div>

        <div class="hp-hero-stage">
          <div class="hp-browser">
            <div class="hp-browser-inner">
              <div class="hp-browser-bar" aria-hidden="true">
                <span></span><span></span><span></span>
                {heroUrlLabel && <span class="hp-browser-url" dir="ltr">{heroUrlLabel}</span>}
              </div>
              <div class="hp-browser-screen">
                <HomeSlot
                  id="hero-desktop"
                  locale={locale}
                  hint="Best client project · desktop (EN)"
                  fallback={heroProject?.image}
                  alt={homeImage('hero-desktop', locale) ? hero.desktopAlt : heroProject?.imageAlt}
                  sizes="(min-width: 1120px) 900px, 80vw"
                  eager
                />
              </div>
            </div>
          </div>
          {showSlot('hero-phone-en', locale) && (
            <div class="hp-phone hp-phone-start">
              <div class="hp-phone-screen">
                <HomeSlot id="hero-phone-en" locale={locale} hint="Mobile · EN" alt={hero.phoneEnAlt} sizes="180px" />
              </div>
            </div>
          )}
          {showSlot('hero-phone-ar', locale) && (
            <div class="hp-phone hp-phone-end">
              <div class="hp-phone-screen">
                <HomeSlot id="hero-phone-ar" locale={locale} hint="Mobile · AR" alt={hero.phoneArAlt} sizes="180px" />
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="hp-hero-foot" aria-hidden="true"></div>
    </section>

    <!-- Selected work -->
    <section id="work" class="hp-section hp-bg-base">
      <div class="hp-container hp-stack-xl">
        <div class="hp-section-head" data-reveal>
          <p class="hp-eyebrow">{nextNo()} — {work.label}</p>
          <h2 class="hp-h2">{work.headingMain} <span class="hp-accent">{work.headingAccent}</span></h2>
        </div>

        <div class="hp-work-list">
          {workEntries.map((card, i) => {
            const thumbs = card.thumbs
              .map((caption, n) => ({ id: `work-${card.key}-${n + 1}`, caption }))
              .filter((th) => showSlot(th.id, locale));
            const Screen = card.href ? 'a' : 'div';
            return (
              <article class="hp-work" data-reveal>
                <div class="hp-work-inner">
                  <header class="hp-work-head">
                    <div class="hp-work-meta">
                      <span class="hp-work-num">{pad(i + 1)}</span>
                      <span class="hp-work-label">{card.label}</span>
                      <span class="hp-dot" aria-hidden="true"></span>
                      <span class="hp-muted">{card.location}</span>
                      {card.isConcept && <span class="hp-concept">{work.concept}</span>}
                    </div>
                    {card.href && (
                      <a class="hp-chip-link" href={card.href}>
                        {work.caseStudy}<span class="sr-only">: {card.title}</span>
                        <Icon name="arrow-up-right" size="sm" class="rtl:-scale-x-100" />
                      </a>
                    )}
                  </header>

                  <div class="hp-work-body">
                    <div class="hp-work-media">
                      <div class="hp-browser hp-browser-sm">
                        <div class="hp-browser-inner">
                          <div class="hp-browser-bar" aria-hidden="true"><span></span><span></span><span></span></div>
                          {/* Until the slot has its own 16:10 image, the frame takes the
                              project screenshot's proportions so nothing is cropped. */}
                          <Screen
                            class="hp-browser-screen hp-ratio-16-10"
                            href={card.href}
                            tabindex={card.href ? '-1' : undefined}
                            style={homeImage(`work-${card.key}-desktop`, locale) ? undefined : slotAspect(`work-${card.key}-desktop`, locale, card.image)}
                          >
                            <HomeSlot
                              id={`work-${card.key}-desktop`}
                              locale={locale}
                              hint="Homepage · desktop"
                              fallback={card.image}
                              alt={card.imageAlt}
                              sizes="(min-width: 1280px) 720px, 100vw"
                            />
                          </Screen>
                        </div>
                      </div>
                      {showSlot(`work-${card.key}-mobile`, locale) && (
                        <div class="hp-phone hp-phone-work">
                          <div class="hp-phone-screen">
                            <HomeSlot
                              id={`work-${card.key}-mobile`}
                              locale={locale}
                              hint="Mobile"
                              alt={fill(work.mobileAlt, { name: card.title })}
                              sizes="150px"
                            />
                          </div>
                        </div>
                      )}
                    </div>

                    <div class="hp-work-text">
                      <h3 class="hp-h3">{card.headline}</h3>
                      <p class="hp-body">{card.description}</p>
                      <dl class="hp-results">
                        {card.results.map((r) => (
                          <div>
                            <dt class="hp-muted">{r.label}</dt>
                            <dd class="hp-result-value"><span dir="ltr">{r.value}</span></dd>
                          </div>
                        ))}
                      </dl>
                      <ul class="hp-tags">
                        {card.tags.map((tag) => <li>{tag}</li>)}
                      </ul>
                    </div>
                  </div>

                  {thumbs.length > 0 && (
                    <div class="hp-thumbs">
                      {thumbs.map((th) => (
                        <figure>
                          <div class="hp-thumb">
                            <HomeSlot
                              id={th.id}
                              locale={locale}
                              hint={th.caption}
                              alt={fill(work.thumbAlt, { name: card.title, caption: th.caption })}
                              sizes="(min-width: 1024px) 380px, 100vw"
                            />
                          </div>
                          <figcaption class="hp-mono hp-muted">{th.caption}</figcaption>
                        </figure>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>

        <div class="hp-center" data-reveal>
          <a class="hp-btn hp-btn-ghost" href={projectsUrl}>
            {work.viewAll}
            <Icon name="arrow-right" size="sm" class="rtl:-scale-x-100" />
          </a>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="hp-section hp-bg-alt">
      <div class="hp-container hp-stack-xl">
        <div class="hp-split-head" data-reveal>
          <div class="hp-section-head">
            <p class="hp-eyebrow">{nextNo()} — {services.label}</p>
            <h2 class="hp-h2">{services.headingMain} <span class="hp-accent">{services.headingAccent}</span></h2>
          </div>
          <p class="hp-lead">{services.lead}</p>
        </div>

        <div class="hp-services">
          {serviceCards.map((card, i) => {
            const href = serviceUrls[card.key];
            const Tag = href ? 'a' : 'div';
            return (
              <Tag class="hp-service" href={href} data-reveal data-reveal-delay={i || undefined}>
                <div class="hp-service-top">
                  <span class="hp-mono hp-muted">{pad(i + 1)}</span>
                  <span class="hp-mono hp-blue">{card.price}</span>
                </div>
                {showSlot(`svc-${card.key}`, locale) && (
                  <div class="hp-service-img">
                    <HomeSlot
                      id={`svc-${card.key}`}
                      locale={locale}
                      hint={`${card.title} screenshot`}
                      alt={fill(services.imageAlt, { title: card.title })}
                      sizes="(min-width: 1280px) 300px, (min-width: 640px) 50vw, 100vw"
                    />
                  </div>
                )}
                <h3 class="hp-h3 hp-h3-sm">{card.title}</h3>
                <p class="hp-body hp-body-sm">{card.description}</p>
                {href && (
                  <span class="hp-more">
                    {services.learnMore}
                    <Icon name="arrow-right" size="sm" class="rtl:-scale-x-100" />
                  </span>
                )}
              </Tag>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Included in every build -->
    <section class="hp-section hp-bg-base">
      <div class="hp-container hp-stack-xl">
        <div class="hp-split-head" data-reveal>
          <div class="hp-section-head">
            <p class="hp-eyebrow">{nextNo()} — {included.label}</p>
            <h2 class="hp-h2">{included.headingMain} <span class="hp-accent">{included.headingAccent}</span></h2>
          </div>
          <p class="hp-lead">{included.lead}</p>
        </div>

        <ul class="hp-included">
          {included.items.map((item, i) => (
            <li class="hp-included-item" data-reveal data-reveal-delay={(i % 4) || undefined}>
              <span class="hp-included-icon" aria-hidden="true">
                <Icon name={item.icon} size="sm" />
              </span>
              <h3 class="hp-point-title">{item.title}</h3>
              <p class="hp-body hp-body-sm">{item.description}</p>
            </li>
          ))}
        </ul>

        <div class="hp-included-foot" data-reveal>
          <p class="hp-body">
            <Icon name="check" size="sm" class="hp-blue" />
            {included.note}
          </p>
          <a class="hp-btn hp-btn-ghost" href={websitesUrl}>
            {included.cta}
            <Icon name="arrow-right" size="sm" class="rtl:-scale-x-100" />
          </a>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="hp-section hp-bg-alt">
      <div class="hp-container hp-stack-xl">
        <div class="hp-section-head" data-reveal>
          <p class="hp-eyebrow">{nextNo()} — {processSection.label}</p>
          <h2 class="hp-h2">{processSection.headingMain} <span class="hp-accent">{processSection.headingAccent}</span></h2>
        </div>
        {/* How long each kind of project takes, on one 8-week scale. Website:
            about 1 week. SaaS / MVP: solid to week 4, hatched to week 8, a demo
            dot every week. Positions use inset-inline-start so Arabic mirrors. */}
        <figure class="hp-timeline" data-reveal>
          {processSection.timeline.rows.map((row, r) => (
            <div class="hp-tl-row">
              <div class="hp-tl-label">
                <span class="hp-tl-name">{row.label}</span>
                <span class="hp-muted">{row.sub}</span>
              </div>
              <div class="hp-tl-track" aria-hidden="true">
                {r === 0 ? (
                  <>
                    <span class="hp-tl-fill" style={`inset-inline-start: 0; inline-size: ${pct(1)}`}></span>
                    <span class="hp-tl-launch" style={`inset-inline-start: ${pct(1)}`}></span>
                  </>
                ) : (
                  <>
                    <span class="hp-tl-fill" style={`inset-inline-start: 0; inline-size: ${pct(4)}`}></span>
                    <span class="hp-tl-range" style={`inset-inline-start: ${pct(4)}; inline-size: ${pct(4)}`}></span>
                    {[1, 2, 3, 4, 5, 6, 7].map((w) => (
                      <span class="hp-tl-demo" style={`inset-inline-start: ${pct(w)}`}></span>
                    ))}
                    <span class="hp-tl-launch" style={`inset-inline-start: ${pct(TIMELINE_WEEKS)}`}></span>
                  </>
                )}
              </div>
              <span class="hp-tl-value">{row.value}</span>
            </div>
          ))}

          <div class="hp-tl-row hp-tl-scale" aria-hidden="true">
            <span class="hp-mono hp-muted">{processSection.timeline.scaleLabel}</span>
            <div class="hp-tl-ticks">
              {Array.from({ length: TIMELINE_WEEKS }, (_, n) => <span>{n + 1}</span>)}
            </div>
            <span></span>
          </div>

          <figcaption class="hp-tl-foot">
            <span class="hp-tl-legend">
              <span class="hp-tl-key hp-tl-key-demo" aria-hidden="true"></span>{processSection.timeline.demoLegend}
            </span>
            <span class="hp-tl-legend">
              <span class="hp-tl-key hp-tl-key-range" aria-hidden="true"></span>{processSection.timeline.rangeLegend}
            </span>
            <span class="hp-tl-legend">
              <span class="hp-tl-key hp-tl-key-launch" aria-hidden="true"></span>{processSection.timeline.launch}
            </span>
            <span class="hp-tl-note">{processSection.timeline.footnote}</span>
          </figcaption>
        </figure>
        <ol class="hp-steps">
          {processSection.steps.map((step, i) => (
            <li class="hp-step" data-reveal data-reveal-delay={i || undefined}>
              <div class="hp-step-line" aria-hidden="true"><span></span><span></span></div>
              <span class="hp-step-num" aria-hidden="true">{pad(i + 1)}</span>
              <h3 class="hp-step-title">{step.title}</h3>
              <p class="hp-body hp-body-sm">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* The stack. Client stories were removed until there are real quotes. */}
    <section class="hp-section hp-bg-base">
      <div class="hp-container hp-stack-xl">
        <div class="hp-built" data-reveal>
          <p class="hp-mono hp-muted">{stackCopy.label}</p>
          <ul class="hp-logo-grid" dir="ltr">
            {stackItems.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  <Icon name={item.icon} size="lg" />
                  <span>{item.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {BLOG_VISIBLE && posts.length > 0 && (
      <section class="hp-section hp-bg-alt">
        <div class="hp-container hp-stack-xl">
          <div class="hp-section-head" data-reveal>
            <p class="hp-eyebrow">{nextNo()} — {blogSection.badge}</p>
            <h2 class="hp-h2">{blogSection.heading}</h2>
          </div>
          <div class="hp-blog dark">
            {posts.map((post, index) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={getPostUrl(post.id, post.data.locale)}
                publishedAt={post.data.publishedAt}
                tags={post.data.tags}
                author={post.data.author}
                image={post.data.image}
                svgSlug={post.data.svgSlug}
                body={post.body}
                revealDelay={index}
              />
            ))}
          </div>
          <div class="hp-center">
            <a class="hp-btn hp-btn-ghost" href={blogUrl}>
              {blogSection.viewAll}
              <Icon name="arrow-right" size="sm" class="rtl:-scale-x-100" />
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Call to action -->
    <section class="hp-cta">
      <div class="hp-container hp-cta-inner" data-reveal>
        <h2 class="hp-h2 hp-h2-xl">{cta.headingMain} <span class="hp-accent">{cta.headingAccent}</span></h2>
        <p class="hp-lead hp-lead-center">{cta.description}</p>
        <div class="hp-cta-bar">
          <span class="hp-face hp-face-cta">
            <HomeSlot id="cta-founder" locale={locale} hint=" " position="center" sizes="48px" />
            {!homeImage('cta-founder', locale) && !SHOW_PLACEHOLDERS && (
              <span class="hp-face-initials" aria-hidden="true">{cta.initials}</span>
            )}
          </span>
          <span class="hp-cta-who">
            <span class="hp-person-name">{cta.contactName}</span>
            <span class="hp-muted">{cta.contactNote}</span>
          </span>
          <a class="hp-btn hp-btn-primary hp-btn-sm" {...bookingLinkAttrs(contactUrl)}>{cta.primary}</a>
          {whatsAppHref && (
            <a class="hp-btn hp-btn-ghost hp-btn-sm hp-btn-wa" href={whatsAppHref}>
              <Icon name="whatsapp" size="sm" />
              {cta.whatsapp}
            </a>
          )}
        </div>
      </div>
    </section>
  </div>
</LandingLayout>
