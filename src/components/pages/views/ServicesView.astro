---
/**
 * ServicesView — the Services page body.
 *
 * Shared by the default-locale route (`/services`) and the locale-prefixed
 * route (`/<locale>/services`). All copy is read from the `pages.services.*`
 * keys in the locale dictionaries via `t()` / `tData()`; internal links are
 * built with `localizedPath` so they stay inside the active locale. Untranslated
 * keys fall back to the default locale.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import ProofTile from '@/components/ui/data-display/ProofTile/ProofTile.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import CtaBand from '@/components/patterns/CtaBand.astro';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';
import { cn } from '@/lib/cn';
import { bookingLinkAttrs, whatsAppUrl } from '@/lib/booking';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

interface IncludedItem {
  lead: string;
  text: string;
}
interface Service {
  badge: string;
  heading: string;
  paragraphs: string[];
  included: IncludedItem[];
}
interface Package {
  name: string;
  for: string;
  price: string;
  /** Shown before the price, e.g. "from". Empty for a fixed price. */
  pricePrefix: string;
  bonus: string;
  features: string[];
  cta: string;
}
interface ProcessStep {
  title: string;
  description: string;
}
interface FaqItem {
  question: string;
  answer: string;
}
interface FaqCard {
  icon: string;
  title: string;
  items: FaqItem[];
}

const { locale = defaultLocale } = Astro.props;

const includedLabel = t('pages.services.includedLabel', locale);
const hero = tData<{ badge: string; titleLead: string; titleHighlight: string; description: string; jumpLabels: string[] }>(
  'pages.services.hero',
  locale
)!;
const web = tData<Service>('pages.services.web', locale)!;
const packages = tData<{ badge: string; heading: string; lead: string; recommended: string; items: Package[]; note: string }>(
  'pages.services.packages',
  locale
)!;
const saas = tData<Service>('pages.services.saas', locale)!;
const ai = tData<Service>('pages.services.ai', locale)!;
const processSection = tData<{ badge: string; heading: string; lead: string; steps: ProcessStep[] }>(
  'pages.services.process',
  locale
)!;
const faq = tData<{ badge: string; heading: string; lead: string; cards: FaqCard[] }>('pages.services.faq', locale)!;
const cta = tData<{ badge: string; heading: string; description: string; primary: string; secondary: string }>(
  'pages.services.cta',
  locale
)!;

const contactUrl = localizedPath('/contact', locale);
const whatsAppHref = whatsAppUrl(t('common.whatsappMessage', locale));
/** The middle package is the one we recommend. */
const RECOMMENDED_PACKAGE = 1;
---
<PageLayout
  title={t('pages.services.meta.title', locale)}
  description={t('pages.services.meta.description', locale)}
  footerBackground="default"
>
  <Hero layout="centered" size="sm" class="isolate services-hero pb-[calc(var(--space-section-sm)_+_var(--space-stack-lg))]" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="sparkles" size="sm" />
      {hero.badge}
    </Badge>
    <h1 slot="title">
      <span class="text-foreground">{hero.titleLead}</span><br />
      <span class="text-brand-500">{hero.titleHighlight}</span>
    </h1>

    <p slot="description">
      {hero.description}
    </p>

    <Fragment slot="actions">
      <Button size="lg" href="#websites" variant="outline" class="hero-btn-opaque">
        {hero.jumpLabels[0]}
        <Icon name="arrow-down" size="sm" class="hero-jump-arrow" />
      </Button>
      <Button size="lg" href="#saas" variant="outline" class="hero-btn-opaque">
        {hero.jumpLabels[1]}
        <Icon name="arrow-down" size="sm" class="hero-jump-arrow" />
      </Button>
      <Button size="lg" href="#ai-mvps" variant="outline" class="hero-btn-opaque">
        {hero.jumpLabels[2]}
        <Icon name="arrow-down" size="sm" class="hero-jump-arrow" />
      </Button>
    </Fragment>
  </Hero>

  <!-- Websites -->
  <section id="websites" class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12 glitch:items-start">
        <!-- Text -->
        <div class="flex flex-col gap-4 sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
              <Icon name="layout" size="sm" />
              {web.badge}
            </Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {web.heading}
            </h2>
          </div>
          {web.paragraphs.map((paragraph) => (
            <p class="text-lg text-foreground-muted leading-relaxed sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0">
              {paragraph}
            </p>
          ))}
        </div>
        <!-- Card -->
        <div class="sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <Card variant="elevated" padding="lg" class="h-full flex flex-col justify-center">
            <div class="flex items-center gap-3 pb-4 mb-4 border-b border-border sm:justify-center glitch:justify-start">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="layout" size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{includedLabel}</h3>
            </div>
            <ul class="flex flex-col gap-3">
              {web.included.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 shrink-0 mt-1" />
                  <p class="text-sm text-foreground-muted leading-relaxed">
                    <span class="font-semibold text-foreground">{item.lead}</span> — {item.text}
                  </p>
                </li>
              ))}
            </ul>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Website packages -->
  <section id="packages" class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="tag" size="sm" />
            {packages.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
            {packages.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {packages.lead}
        </p>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {packages.items.map((pkg, i) => {
          const recommended = i === RECOMMENDED_PACKAGE;
          return (
            <Card
              variant="elevated"
              padding="lg"
              class={cn('flex flex-col h-full', recommended && 'ring-2 ring-brand-500')}
              data-reveal
              data-reveal-delay={i || undefined}
            >
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-display text-xl font-bold text-foreground">{pkg.name}</h3>
                {recommended && <Badge variant="brand" pill>{packages.recommended}</Badge>}
              </div>
              <p class="mt-2 text-sm text-foreground-muted leading-relaxed">{pkg.for}</p>
              <p class="mt-6 flex items-baseline gap-2">
                {pkg.pricePrefix && <span class="text-sm text-foreground-muted">{pkg.pricePrefix}</span>}
                <span class="font-display text-4xl font-bold text-foreground">{pkg.price}</span>
              </p>
              <p class="mt-3 text-sm font-semibold text-brand-700 dark:text-brand-400">{pkg.bonus}</p>
              <ul class="mt-6 mb-8 flex flex-1 flex-col gap-3 border-t border-border pt-6">
                {pkg.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <Icon name="check" size="sm" class="text-brand-500 shrink-0 mt-0.5" />
                    <span class="text-sm text-foreground-muted leading-relaxed">{feature}</span>
                  </li>
                ))}
              </ul>
              <Button size="lg" fullWidth variant={recommended ? 'primary' : 'outline'} {...bookingLinkAttrs(contactUrl)}>
                {pkg.cta}
              </Button>
            </Card>
          );
        })}
      </div>

      <p class="text-sm text-foreground-muted text-center max-w-3xl mx-auto text-balance" data-reveal>
        {packages.note}
      </p>
    </div>
  </section>

  <!-- SaaS products -->
  <section id="saas" class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12 glitch:items-start">
        <!-- Text -->
        <div class="flex flex-col gap-4 sm:items-center sm:text-center glitch:order-2 glitch:items-start glitch:text-left" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
              <Icon name="layers" size="sm" />
              {saas.badge}
            </Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {saas.heading}
            </h2>
          </div>
          {saas.paragraphs.map((paragraph) => (
            <p class="text-lg text-foreground-muted leading-relaxed sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0">
              {paragraph}
            </p>
          ))}
        </div>
        <!-- Card -->
        <div class="sm:max-w-xl sm:mx-auto glitch:order-1 glitch:max-w-none glitch:mx-0" data-reveal data-reveal-ease="smooth">
          <Card variant="elevated" padding="lg" class="h-full flex flex-col justify-center">
            <div class="flex items-center gap-3 pb-4 mb-4 border-b border-border sm:justify-center glitch:justify-start">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="layers" size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{includedLabel}</h3>
            </div>
            <ul class="flex flex-col gap-3">
              {saas.included.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 shrink-0 mt-1" />
                  <p class="text-sm text-foreground-muted leading-relaxed">
                    <span class="font-semibold text-foreground">{item.lead}</span> — {item.text}
                  </p>
                </li>
              ))}
            </ul>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- AI-first MVPs -->
  <section id="ai-mvps" class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12 glitch:items-start">
        <!-- Text -->
        <div class="flex flex-col gap-4 sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
              <Icon name="sparkles" size="sm" />
              {ai.badge}
            </Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {ai.heading}
            </h2>
          </div>
          {ai.paragraphs.map((paragraph) => (
            <p class="text-lg text-foreground-muted leading-relaxed sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0">
              {paragraph}
            </p>
          ))}
        </div>
        <!-- Card -->
        <div class="sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <Card variant="elevated" padding="lg" class="h-full flex flex-col justify-center">
            <div class="flex items-center gap-3 pb-4 mb-4 border-b border-border sm:justify-center glitch:justify-start">
              <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name="sparkles" size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{includedLabel}</h3>
            </div>
            <ul class="flex flex-col gap-3">
              {ai.included.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 shrink-0 mt-1" />
                  <p class="text-sm text-foreground-muted leading-relaxed">
                    <span class="font-semibold text-foreground">{item.lead}</span> — {item.text}
                  </p>
                </li>
              ))}
            </ul>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="list-checks" size="sm" />
            {processSection.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {processSection.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {processSection.lead}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSection.steps.map((step, i) => (
          <ProofTile number={i + 1} title={step.title} data-reveal data-reveal-delay={i || undefined}>
            {step.description}
          </ProofTile>
        ))}
      </div>
    </div>
  </section>

  <!-- Questions & answers -->
  <section id="faq" class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="info" size="sm" />
            {faq.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
            {faq.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {faq.lead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {faq.cards.map((card, cardIndex) => (
          <Card variant="elevated" padding="lg" data-reveal data-reveal-delay={cardIndex + 1}>
            <div class="flex items-center gap-3 pb-4 border-b border-border">
              <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name={card.icon} size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{card.title}</h3>
            </div>
            <div class="w-full">
              {card.items.map((item) => (
                <details class="border-b border-border last:border-0" name={`services-faq-${cardIndex}`}>
                  <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    {item.question}
                    <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
                  </summary>
                  <div class="pb-4 text-sm text-foreground-muted leading-relaxed" set:html={item.answer} />
                </details>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <CtaBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {cta.heading}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" {...bookingLinkAttrs(contactUrl)}>
          {cta.primary}
          <Icon name="arrow-right" size="sm" />
        </Button>
        {whatsAppHref && (
          <Button size="lg" variant="outline" class="cta-btn-brand" href={whatsAppHref}>
            <Icon name="whatsapp" size="sm" />
            {cta.secondary}
          </Button>
        )}
      </div>
    </CtaBand>
  </section>
</PageLayout>

<style is:global>
  /* FAQ accordion: rotate the chevron while an item is open. */
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }

  /* Gentle "scroll down" bounce on the hero jump-button arrows — same motion
     language as the homepage hero scroll indicator. */
  .services-hero .hero-jump-arrow {
    animation: hero-jump-arrow-bounce 1.8s ease-in-out infinite;
  }
  @keyframes hero-jump-arrow-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .services-hero .hero-jump-arrow { animation: none; }
  }

  /* Page-local override: anchor links on /services should land the
     section's coloured edge flush against the fixed header. */
  html { scroll-padding-top: 4rem; }
  @media (max-height: 600px) { html { scroll-padding-top: 4rem; } }
  @media (min-width: 1024px) { html { scroll-padding-top: 4rem; } }

  /* In-page anchor jumps (the hero section buttons) tag their destination —
     and everything above it — with .reveal-instant so the content is already
     in its final position when the smooth-scroll lands, instead of sliding in
     mid-jump. Natural scrolling is untouched and still animates. */
  .reveal-instant[data-reveal],
  .reveal-instant [data-reveal],
  .reveal-instant[data-reveal-children] > *,
  .reveal-instant [data-reveal-children] > * {
    opacity: 1;
    transform: none;
    transition: none;
  }
</style>

<script is:inline>
  /* When a hero section button is clicked — or the page is opened directly on
     one of those sections (e.g. /services#development) — the destination (and
     everything the jump scrolls past) is snapped to its revealed state before
     the scroll lands, so cards don't slide in mid-jump. Sections below the
     target stay observed, so natural scrolling still animates normally. */
  (function () {
    function initServicesHeroJump() {
      const hero = document.querySelector('.services-hero');
      if (!hero) return;
      const buttons = hero.querySelectorAll('a[href^="#"]');
      if (!buttons.length) return;

      function revealUpToAndIncluding(target) {
        const reveals = document.querySelectorAll('[data-reveal], [data-reveal-children]');
        Array.prototype.forEach.call(reveals, function (el) {
          const targetFollowsEl =
            el.compareDocumentPosition(target) & Node.DOCUMENT_POSITION_FOLLOWING;
          if (el === target || target.contains(el) || targetFollowsEl) {
            el.classList.add('reveal-instant', 'is-visible');
          }
        });
      }

      const targetIds = [];
      Array.prototype.forEach.call(buttons, function (btn) {
        const hash = btn.getAttribute('href');
        const id = hash ? hash.slice(1) : '';
        if (id) targetIds.push(id);
        btn.addEventListener('click', function () {
          const target = id && document.getElementById(id);
          if (target) revealUpToAndIncluding(target);
        });
      });

      const initialId = location.hash ? location.hash.slice(1) : '';
      if (initialId && targetIds.indexOf(initialId) !== -1) {
        const target = document.getElementById(initialId);
        if (target) revealUpToAndIncluding(target);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initServicesHeroJump);
    } else {
      initServicesHeroJump();
    }
  })();
</script>
