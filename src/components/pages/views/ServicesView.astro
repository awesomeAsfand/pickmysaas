---
/**
 * The Services hub (/services/ and /ar/services/), rebuilt in V5 for the
 * five services (16 Nov 2026): website design, e-commerce stores, Arabic &
 * RTL, brand identity, growth & care. Brand identity and Growth & care have
 * their full sections here (#brand-identity, #growth-care) and no pages of
 * their own yet: there is no client proof for them.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import SectionHead from '@/components/ds/SectionHead.astro';
import Faq from '@/components/ds/Faq.astro';
import Services from '@/components/home/Services.astro';
import Process from '@/components/home/Process.astro';
import PackagesSection from '@/components/services/PackagesSection.astro';
import ServiceCta from '@/components/services/ServiceCta.astro';
import { createFAQSchema } from '@/lib/schema';
import { t, tData, defaultLocale, localizedPath, getLocaleDirection } from '@/i18n';
import { bookingLinkAttrs } from '@/lib/booking';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const arrow = getLocaleDirection(locale) === 'rtl' ? '←' : '→';
type Section = { badge: string; heading: string; lead: string; paragraphs: string[]; items: string[] };
const page = tData<{
  hero: { badge: string; titleLead: string; titleHighlight: string; description: string };
  brand: Section;
  growth: Section;
  book: string;
  faq: { badge: string; heading: string; lead: string; items: { question: string; answer: string }[] };
  cta: { heading: string; description: string; primary: string; secondary: string };
}>('pages.services', locale)!;
const contactUrl = localizedPath('/contact', locale);
const breadcrumbs = [
  { label: t('common.home', locale), href: localizedPath('/', locale) },
  { label: t('nav.items.services', locale) },
];
const extra = [
  { id: 'brand-identity', copy: page.brand, tone: 'ds-card--sand' },
  { id: 'growth-care', copy: page.growth, tone: '' },
];
---

<PageLayout
  title={t('pages.services.meta.title', locale)}
  description={t('pages.services.meta.description', locale)}
  extraSchemas={[createFAQSchema(page.faq.items)]}
  flush
>
  <Hero>
    <Badge slot="badge" variant="brand">{page.hero.badge}</Badge>
    <h1 slot="title">
      <span>{page.hero.titleLead}</span><br /><span class="text-brand-500">{page.hero.titleHighlight}</span>
    </h1>
    <p slot="description">{page.hero.description}</p>
    <Fragment slot="actions">
      <a class="ds-btn" {...bookingLinkAttrs(contactUrl)}>{page.book}<span aria-hidden="true">{arrow}</span></a>
      <a class="ds-btn ds-btn--outline" href={localizedPath('/pricing', locale)}>{t('home.hero.prices', locale)}</a>
    </Fragment>
    <Breadcrumbs slot="bottom" items={breadcrumbs} class="svh-crumbs" />
  </Hero>

  <Services locale={locale} auto />

  {
    extra.map(({ id, copy, tone }) => (
      <section id={id} class="ds-wrap ds-section--sm svh-extra">
        <SectionHead label={copy.badge} title={copy.heading} size="2" />
        <div class:list={['ds-card', tone, 'svh-card']} data-reveal>
          <div class="svh-card__text">
            <p class="svh-price">{copy.lead}</p>
            {copy.paragraphs.map((p) => (
              <p class="ds-body">{p}</p>
            ))}
            <a class="ds-btn" {...bookingLinkAttrs(contactUrl)}>
              {page.book}
              <span aria-hidden="true">{arrow}</span>
            </a>
          </div>
          <ul class="ds-list">
            {copy.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <PackagesSection locale={locale} />

  <Process locale={locale} auto />

  <section id="faq" class="ds-wrap ds-section--sm">
    <SectionHead label={page.faq.badge} title={page.faq.heading} lead={page.faq.lead} size="2" />
    <Faq items={page.faq.items} name="services-faq" headingLevel="h3" />
  </section>

  <ServiceCta locale={locale} cta={page.cta} />
</PageLayout>

<style>
  :global(.svh-crumbs) {
    margin-block-start: clamp(28px, 3vw, 40px);
  }
  .svh-card {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
  }
  .svh-card__text {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .svh-card__text :global(p) {
    margin: 0;
  }
  .svh-price {
    font-family: var(--fd);
    font-weight: 850;
    font-stretch: var(--fs);
    letter-spacing: var(--ls);
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1.15;
    color: var(--ink) !important;
  }
</style>
