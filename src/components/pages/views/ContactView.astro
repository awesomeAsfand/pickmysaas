---
/**
 * Contact (/contact/, /ar/contact/), rebuilt in V5: the same contact section
 * as the home page (WhatsApp, email, the Cal.com calendar and the brief form),
 * with its "Let's talk." title as the page's h1. The pricing page's "Get a
 * fixed price" links to #contact-brief, which opens the brief tab.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Contact from '@/components/home/Contact.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import { t, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const breadcrumbs = [
  { label: t('common.home', locale), href: localizedPath('/', locale) },
  { label: t('nav.items.contact', locale) },
];
---

<PageLayout title={t('pages.contact.meta.title', locale)} description={t('pages.contact.meta.description', locale)} flush>
  <div class="ds-wrap ct-crumbs">
    <Breadcrumbs items={breadcrumbs} />
  </div>
  <div class="ct">
    <Contact locale={locale} n="01" as="h1" formId="contact-brief" />
  </div>
</PageLayout>

<style>
  .ct-crumbs {
    padding-block-start: clamp(20px, 3vw, 32px);
  }
  .ct :global(#contact) {
    padding-block-start: clamp(28px, 4vw, 48px);
  }
</style>
