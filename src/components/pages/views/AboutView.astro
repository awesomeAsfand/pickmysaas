---
/**
 * About (/about/, /ar/about/), rebuilt in V5: founder-led,
 * what we build and don't, the studio statement and principles, selected
 * work, and an FAQ that opens with "What is PickMySaaS?" (the name no longer
 * describes the services, and a search for it also finds an unrelated
 * company). FAQPage markup matches the page. The founder is not named
 * (owner request, 19 Nov 2026). Copy in `pages.about`.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import SectionHead from '@/components/ds/SectionHead.astro';
import Faq from '@/components/ds/Faq.astro';
import About from '@/components/home/About.astro';
import Work from '@/components/home/Work.astro';
import ServiceAudience, { type ServiceAudienceCopy } from '@/components/services/ServiceAudience.astro';
import ServiceCta from '@/components/services/ServiceCta.astro';
import { createFAQSchema } from '@/lib/schema';
import { t, tData, defaultLocale, localizedPath, getLocaleDirection } from '@/i18n';
import { bookingLinkAttrs } from '@/lib/booking';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const arrow = getLocaleDirection(locale) === 'rtl' ? '←' : '→';
const page = tData<{
  hero: { badge: string; titleLead: string; titleHighlight: string; description: string };
  founder: { badge: string; heading: string; paragraphs: string[]; facts: { label: string; value: string }[] };
  scope: ServiceAudienceCopy;
  faq: { badge: string; heading: string; items: { question: string; answer: string }[] };
  cta: { heading: string; description: string; primary: string; secondary: string };
}>('pages.about', locale)!;
const breadcrumbs = [
  { label: t('common.home', locale), href: localizedPath('/', locale) },
  { label: t('nav.items.about', locale) },
];
---

<PageLayout
  title={t('pages.about.meta.title', locale)}
  description={t('pages.about.meta.description', locale)}
  extraSchemas={[createFAQSchema(page.faq.items)]}
  flush
>
  <Hero>
    <Badge slot="badge" variant="brand">{page.hero.badge}</Badge>
    <h1 slot="title"><span>{page.hero.titleLead}</span> <span class="text-brand-500">{page.hero.titleHighlight}</span></h1>
    <p slot="description">{page.hero.description}</p>
    <Fragment slot="actions">
      <a class="ds-btn" {...bookingLinkAttrs(localizedPath('/contact', locale))}>{page.cta.primary}<span aria-hidden="true">{arrow}</span></a>
    </Fragment>
    <Breadcrumbs slot="bottom" items={breadcrumbs} class="ab-crumbs" />
  </Hero>

  <section class="ds-wrap ds-section--sm">
    <SectionHead label={page.founder.badge} title={page.founder.heading} size="2" />
    <div class="ab-founder" data-reveal>
      <div class="ab-founder__text">
        {page.founder.paragraphs.map((p) => <p class="ds-body">{p}</p>)}
      </div>
      <dl class="ds-card ab-facts">
        {
          page.founder.facts.map((fact) => (
            <div>
              <dt class="ds-label">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <ServiceAudience copy={page.scope} class="ab-scope" />
  </section>

  <About locale={locale} auto />

  <Work locale={locale} auto />

  <section id="faq" class="ds-wrap ds-section--sm">
    <SectionHead label={page.faq.badge} title={page.faq.heading} size="2" />
    <Faq items={page.faq.items} name="about-faq" headingLevel="h3" />
  </section>

  <ServiceCta locale={locale} cta={page.cta} />
</PageLayout>

<style>
  :global(.ab-crumbs) {
    margin-block-start: clamp(28px, 3vw, 40px);
  }
  .ab-founder {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .ab-founder__text {
    display: grid;
    gap: 16px;
    max-width: 640px;
  }
  .ab-founder__text p {
    margin: 0;
    font-size: var(--text-lead);
  }
  .ab-facts {
    margin: 0;
    display: grid;
    gap: 0;
  }
  .ab-facts > div {
    display: grid;
    gap: 4px;
    padding-block: 14px;
    border-block-start: 1px solid var(--line);
  }
  .ab-facts > div:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }
  .ab-facts dt {
    color: var(--ink-3);
  }
  .ab-facts dd {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
  }
  :global(.ab-scope) {
    margin-block-start: clamp(40px, 5vw, 64px);
  }
</style>
