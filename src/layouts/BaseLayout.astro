---
/**
 * The document every page renders into: <head> (SEO, JSON-LD, analytics,
 * font preloads) and the global furniture (skip link, consent banner, Cal.com
 * booking popup, floating WhatsApp button).
 *
 * One light theme: no colour-mode script, no theme attributes.
 */
import '@/styles/global.css';
import archivoFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import plexArabicFont from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';
import kufiArabicFont from '@fontsource-variable/noto-kufi-arabic/files/noto-kufi-arabic-arabic-wght-normal.woff2?url';
import SEO from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Analytics from '@/components/layout/Analytics.astro';
import ConsentBanner from '@/components/ui/overlay/ConsentBanner';
import BookingPopup from '@/components/patterns/BookingPopup.astro';
import FloatingWhatsApp from '@/components/patterns/FloatingWhatsApp.astro';
import { createWebsiteSchema, createOrganizationSchema, createPersonSchema, createProfessionalServiceSchema } from '@/lib/schema';
import type { Thing, WithContext } from 'schema-dts';
import siteConfig from '@/config/site.config';
import { t, tData, getLocaleFromPath, getLocaleDirection } from '@/i18n';
import { getRssUrl, BLOG_VISIBLE } from '@/lib/blog';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  includePersonSchema?: boolean;
  includeProfessionalServiceSchema?: boolean;
  extraSchemas?: WithContext<Thing>[];
  /** Verified locale alternates for this page, forwarded to SEO for hreflang. */
  localeAlternates?: { locale: string; url: string }[];
  /** Hide the floating WhatsApp button on this page. */
  hideWhatsApp?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
  includePersonSchema = false,
  includeProfessionalServiceSchema = false,
  extraSchemas = [],
  localeAlternates,
  hideWhatsApp = false,
} = Astro.props;

const schemas: WithContext<Thing>[] = [createWebsiteSchema()];
if (includeOrgSchema) schemas.push(createOrganizationSchema());
if (includePersonSchema) schemas.push(createPersonSchema());
if (includeProfessionalServiceSchema) schemas.push(createProfessionalServiceSchema());
schemas.push(...extraSchemas);

const locale = getLocaleFromPath(Astro.url.pathname);
const dir = getLocaleDirection(locale);
const consentText = tData<{
  ui: Record<string, string>;
  categories: Record<string, { label: string; description: string }>;
}>('consent', locale);
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload only the fonts the first screen uses, per language. English:
         Archivo (one variable file holds every weight and width). Arabic: the
         body face and the Kufi display face; Latin words there (the wordmark,
         "SaaS") use Archivo, which may arrive a moment later. -->
    {
      dir === 'rtl' ? (
        <>
          <link rel="preload" as="font" type="font/woff2" href={plexArabicFont} crossorigin="anonymous" />
          <link rel="preload" as="font" type="font/woff2" href={kufiArabicFont} crossorigin="anonymous" />
        </>
      ) : (
        <link rel="preload" as="font" type="font/woff2" href={archivoFont} crossorigin="anonymous" />
      )
    }
    <slot name="head" />

    <link rel="icon" type="image/svg+xml" href={siteConfig.branding.favicon.svg} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={siteConfig.branding.colors.themeColor} />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      article={article}
      noindex={noindex}
      nofollow={nofollow}
      localeAlternates={localeAlternates}
    />

    {BLOG_VISIBLE && <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href={getRssUrl(locale)} />}

    <JsonLd schema={schemas} />

    <Analytics />
  </head>

  <body>
    <a href="#main-content" class="ds-skip">{t('nav.skipToContent', locale)}</a>

    <slot name="header" />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />

    <ConsentBanner ui={consentText?.ui} categoryText={consentText?.categories} />
    <BookingPopup />
    {!hideWhatsApp && <FloatingWhatsApp locale={locale} />}

    <!-- Scroll reveal (fix 10). Content is visible by default: this only
         hides what starts below the fold, then shows it as it scrolls in. If
         the script never runs, nothing is ever hidden. Uses
         IntersectionObserver, so it reads no layout before first paint. -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const targets = Array.prototype.slice.call(document.querySelectorAll('[data-reveal], [data-reveal-children]'));
        document.querySelectorAll('[data-reveal-content]').forEach(function (box) {
          Array.prototype.push.apply(targets, box.children);
        });
        if (!targets.length) return;

        const seen = new WeakSet();
        const io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              const el = entry.target;
              if (!seen.has(el)) {
                seen.add(el);
                // First report: hide only what is still below the screen.
                if (!entry.isIntersecting && entry.boundingClientRect.top > window.innerHeight) {
                  el.setAttribute('data-reveal-pending', '');
                  return;
                }
                io.unobserve(el);
                return;
              }
              if (entry.isIntersecting) {
                el.removeAttribute('data-reveal-pending');
                io.unobserve(el);
              }
            });
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
