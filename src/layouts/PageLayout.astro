---
/**
 * PageLayout: header + page + footer, for every standard page.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { Thing, WithContext } from 'schema-dts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  /** Verified `hreflang` alternates, for a page that doesn't exist in every locale. */
  localeAlternates?: { locale: string; url: string }[];
  /** Language switch links for a page whose translation isn't at the same path in each locale. */
  languageAlternates?: Record<string, string>;
  extraSchemas?: WithContext<Thing>[];
  hideWhatsApp?: boolean;
  includeOrgSchema?: boolean;
  includeProfessionalServiceSchema?: boolean;
  /** No top padding: the page opens with its own hero spacing. */
  flush?: boolean;
  /** @deprecated v1 leftover, ignored. Removed when the templates are rebuilt (V5). */
  showScrollProgress?: boolean;
  /** @deprecated v1 leftover, ignored. */
  eagerReveal?: boolean;
  /** @deprecated v1 leftover, ignored. */
  footerBackground?: 'default' | 'secondary' | 'invert';
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex,
  nofollow,
  localeAlternates,
  languageAlternates,
  extraSchemas,
  hideWhatsApp,
  includeOrgSchema,
  includeProfessionalServiceSchema,
  flush = false,
} = Astro.props;

// A page in one language only (an hreflang list of one) whose switch points
// at a related page in the other language: the switch must not call that a
// translation.
const notTwin = !!languageAlternates && !!localeAlternates && localeAlternates.length < 2;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  localeAlternates={localeAlternates}
  extraSchemas={extraSchemas}
  hideWhatsApp={hideWhatsApp}
  includeOrgSchema={includeOrgSchema}
  includeProfessionalServiceSchema={includeProfessionalServiceSchema}
>
  <slot name="head" slot="head" />
  <Header slot="header" languageAlternates={languageAlternates} notTwin={notTwin} />
  <div class:list={['page', flush && 'page--flush']}>
    <slot />
  </div>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .page {
    min-height: 70vh;
    padding-block-start: var(--header-offset);
  }
  .page--flush {
    padding-block-start: calc(var(--header-offset) + 8px);
  }
</style>
