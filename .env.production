# Production-only settings, read by `astro build` (not `astro dev`, so local
# testing never shows up in analytics). Only public values belong here: this
# file is committed, and everything in it ends up in the page source anyway.

# Google Analytics 4
PUBLIC_GA_MEASUREMENT_ID=G-B3TB38QNDK

# Cookie consent banner (text: consent.* in src/i18n/*.json). With Consent
# Mode v2 (src/config/consent.config.ts), GA loads with storage denied and
# only sets cookies once a visitor accepts analytics.
PUBLIC_CONSENT_ENABLED=true
